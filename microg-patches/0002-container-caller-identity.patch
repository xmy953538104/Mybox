diff --git a/play-services-base/core/src/main/java/org/microg/gms/common/MyboxIdentity.java b/play-services-base/core/src/main/java/org/microg/gms/common/MyboxIdentity.java
new file mode 100644
index 0000000..1ff45a3
--- /dev/null
+++ b/play-services-base/core/src/main/java/org/microg/gms/common/MyboxIdentity.java
@@ -0,0 +1,96 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Mybox contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.microg.gms.common;
+
+import android.content.Context;
+import android.content.pm.ProviderInfo;
+import android.net.Uri;
+import android.os.Binder;
+import android.os.Bundle;
+
+import java.util.Arrays;
+
+/** The container resolves kernel Binder credentials against its registered guest processes. */
+public final class MyboxIdentity {
+    private static final String HOST_PACKAGE = "io.github.xmy953538104.mybox";
+    private static final String AUTHORITY = HOST_PACKAGE + ".identity";
+
+    private MyboxIdentity() {}
+
+    public static Identity resolve(Context context) {
+        final int originalUid = Binder.getCallingUid();
+        final int originalPid = Binder.getCallingPid();
+        return resolve(context, originalUid, originalPid);
+    }
+
+    private static Identity resolve(Context context, int originalUid, int originalPid) {
+        ProviderInfo provider = context.getPackageManager().resolveContentProvider(AUTHORITY, 0);
+        if (provider == null) return null;
+        if (!HOST_PACKAGE.equals(provider.packageName)) {
+            throw new SecurityException("Unexpected identity provider owner");
+        }
+        Bundle request = new Bundle();
+        request.putInt("originalUid", originalUid);
+        request.putInt("originalPid", originalPid);
+        final Bundle response;
+        long token = Binder.clearCallingIdentity();
+        try {
+            response = context.getContentResolver().call(Uri.parse("content://" + AUTHORITY), "resolveCallingIdentity", null, request);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+        if (response == null) throw new SecurityException("Identity provider returned no identity");
+        return new Identity(response.getInt("uid", -1), originalPid, response.getInt("userId", -1),
+                response.getString("packageName"), response.getStringArray("packages"));
+    }
+
+    public static int getCallingUid(Context context) {
+        Identity identity = resolve(context);
+        return identity != null ? identity.uid : Binder.getCallingUid();
+    }
+
+    public static boolean isCallingSelf(Context context) {
+        return getCallingUid(context) == context.getApplicationInfo().uid;
+    }
+
+    public static Identity resolveForwardedAccountCaller(Context context, int forwardedPid) {
+        final int originalUid = Binder.getCallingUid();
+        Identity incoming = resolve(context);
+        if (incoming == null) return null;
+        if (incoming.uid != 1000 || !"android".equals(incoming.packageName)) {
+            throw new SecurityException("Only the authenticated account server may forward callers");
+        }
+        // Re-resolve the saved client PID instead of trusting the account options as identity.
+        Identity forwarded = resolve(context, originalUid, forwardedPid);
+        if (forwarded == null) throw new SecurityException("Account identity provider disappeared");
+        return forwarded;
+    }
+
+    public static final class Identity {
+        public final int uid;
+        public final int pid;
+        public final String packageName;
+        public final String[] packages;
+
+        Identity(int uid, int pid, int userId, String packageName, String[] packages) {
+            if (uid <= 0 || pid <= 0 || userId < 0 || uid / 100000 != userId || packageName == null ||
+                    packageName.isEmpty() || packages == null || packages.length == 0 || !Arrays.asList(packages).contains(packageName)) {
+                throw new SecurityException("Invalid container identity");
+            }
+            this.uid = uid;
+            this.pid = pid;
+            this.packageName = packageName;
+            this.packages = packages.clone();
+        }
+
+        public String checkSuggested(String suggestedPackage, int suggestedUid, int suggestedPid) {
+            if ((suggestedUid > 0 && suggestedUid != uid) || (suggestedPid > 0 && suggestedPid != pid) ||
+                    (suggestedPackage != null && !suggestedPackage.equals(packageName))) {
+                throw new SecurityException("Claimed caller does not match the registered process");
+            }
+            return packageName;
+        }
+    }
+}
