<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" />
    <uses-permission android:name="android.permission.MANAGE_ACCOUNTS" />
    <application android:label="Mylite account UI authenticator" android:theme="@android:style/Theme.Material.Light">
        <service android:name=".FixtureAuthenticator" android:process=":auth" android:exported="true" android:permission="android.permission.BIND_ACCOUNT_AUTHENTICATOR">
            <intent-filter><action android:name="android.accounts.AccountAuthenticator" /></intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator" android:resource="@xml/authenticator" />
        </service>
        <activity android:name=".AuthActivity" android:process=":ui" android:exported="false" />
        <activity android:name=".OtherActivity" android:process=":ui" android:exported="false" />
        <activity android:name=".SingleTaskActivity" android:process=":ui" android:launchMode="singleTask" android:exported="false" />
    </application>
</manifest>
