<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="@raw/test_ca" /></trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">allowed.mylite.test</domain>
    </domain-config>
    <domain-config>
        <domain>pinned.mylite.test</domain>
        <pin-set expiration="2040-01-01"><pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin></pin-set>
    </domain-config>
</network-security-config>
