+/*
+ * Copyright (C) 2026 Mybox contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.microg.gms.gservices;
+
+import android.net.Uri;
+import android.util.Log;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.AtomicLongArray;
+
+/** Process-local counts only; no flag names, values, caller identities or query arguments are retained. */
+final class GServicesQueryStats {
+    static final int DENIED = 0, AUTHORIZED_NULL = 1, ROWS = 2, THROWN = 3;
+    private static final String[] KINDS = {"prefix", "singleOther"};
+    private static final String[] RESULTS = {"denied", "authorizedNull", "rows", "thrown"};
+    private final AtomicLong queries = new AtomicLong();
+    private final AtomicLongArray outcomes = new AtomicLongArray(8);
+    private final AtomicLong rows = new AtomicLong(), totalNanos = new AtomicLong(), maxNanos = new AtomicLong();
+
+    private static boolean sample(long number) {
+        // Four initial snapshots + 60 periodic snapshots, then counters only until process exit.
+        return number > 0 && (number <= 4 || number <= 128L * 60 && number % 128 == 0);
+    }
+
+    void record(Uri uri, Uri prefix, int outcome, int returnedRows, long startedNanos) {
+        try {
+            if (outcome < DENIED || outcome > THROWN || returnedRows < 0) return;
+            int kind = prefix.equals(uri) ? 0 : 1;
+            long elapsed = Math.max(0, System.nanoTime() - startedNanos);
+            outcomes.incrementAndGet(kind * 4 + outcome);
+            rows.addAndGet(returnedRows);
+            totalNanos.addAndGet(elapsed);
+            for (long previous = maxNanos.get(); elapsed > previous; previous = maxNanos.get())
+                if (maxNanos.compareAndSet(previous, elapsed)) break;
+            long completed = queries.incrementAndGet();
+            if (!sample(completed)) return;
+            StringBuilder message = new StringBuilder("completed=").append(completed);
+            for (int category = 0; category < KINDS.length; category++)
+                for (int result = 0; result < RESULTS.length; result++)
+                    message.append(' ').append(KINDS[category]).append('.').append(RESULTS[result])
+                            .append('=').append(outcomes.get(category * 4 + result));
+            message.append(" rowsTotal=").append(rows.get()).append(" totalUs=").append(totalNanos.get() / 1000)
+                    .append(" maxUs=").append(maxNanos.get() / 1000);
+            Log.i("MyliteGServices", message.toString());
+        } catch (Throwable diagnosticFailure) {
+            // Diagnostics alone must never replace a real query result or its original exception.
+        }
+    }
+}
